# Prism API Environment Template
# In dry-run all credentials can be dummy. In live mode startup fails if any required value is missing.
# Secrets should be provided via SealedSecrets when deployed to Kubernetes.

##########################
# Required Configuration #
##########################

# Execution mode: dry-run-sandbox | dry-run-server | live
EXECUTION_MODE=dry-run-server

# JWT signing secret for API authentication
JWT_SECRET=

###############################
# Required in LIVE mode only  #
###############################

# Binance API credentials used for trade execution
BINANCE_KEY=
BINANCE_SECRET=

############################
# Optional but Recommended #
############################

# SMTP settings for alert emails
SMTP_HOST=smtp.yourprovider.com
SMTP_USER=alerts@example.com
SMTP_PASS=
ALERT_RECIPIENT=ops@example.com

# Administrative tokens for manual endpoints
ADMIN_TOKEN=
API_KEY=

# Database connection (local dev defaults)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=arbdb

# Additional alert channels
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=

# Observability
SENTRY_DSN=
REDIS_URL=redis://localhost:6379
WS_PORT=8070
PROM_URL=http://prometheus:9090
LOG_LEVEL=info

# Sandbox compatibility flag (deprecated; prefer EXECUTION_MODE)
SANDBOX_MODE=true
NODE_ENV=development
TEST_ENV=local
