# Secret used to sign JWT tokens
JWT_SECRET=<REPLACE_ME>
# Token required for admin endpoints
ADMIN_TOKEN=<REPLACE_ME>
# API key for programmatic access
API_KEY=<REPLACE_ME>
# Binance API credentials
BINANCE_KEY=<REPLACE_ME>
BINANCE_SECRET=<REPLACE_ME>

# Database host
PGHOST=localhost
# Database port
PGPORT=5432
# Database user
PGUSER=postgres
# Database password
PGPASSWORD=<REPLACE_ME>
# Database name
PGDATABASE=arbdb

# SMTP server host (defaults to smtp.gmail.com)
SMTP_HOST=smtp.gmail.com
# SMTP username for outgoing mail
SMTP_USER=alerts@example.com
# SMTP password for outgoing mail (use Gmail app password)
SMTP_PASS=<REPLACE_ME>
# Email recipient for alerts
ALERT_RECIPIENT=ops@example.com

# Telegram bot token
TELEGRAM_TOKEN=<REPLACE_ME>
# Telegram chat ID for alerts
TELEGRAM_CHAT_ID=<REPLACE_ME>

# Webhook URL for alerts
WEBHOOK_URL=<REPLACE_ME>

# Sentry DSN for error tracking
SENTRY_DSN=<REPLACE_ME>

# Redis connection URL
REDIS_URL=redis://localhost:6379
# WebSocket server port
WS_PORT=8070
# Prometheus base URL
PROM_URL=http://prometheus:9090
# Logging level (info or debug)
LOG_LEVEL=info

# Enable sandbox login mode (true/false). Controls dry-run behavior
SANDBOX_MODE=true
# Node.js runtime mode (development, production, test)
NODE_ENV=development
# Test suite environment (local, live)
TEST_ENV=local
