# WebSocket feed URL
FEED_URL=wss://example.com/feed
# Redis connection
# Redis connection URL
REDIS_URL=redis://localhost:6379
# Pub/sub channels
ORDERBOOK_CHANNEL=orderbook
ALERT_CHANNEL=alerts
# Liveness probe port
HEALTH_PORT=8090
# Maximum reconnect attempts
MAX_RECONNECT_ATTEMPTS=5
# Logging level
LOG_LEVEL=info
