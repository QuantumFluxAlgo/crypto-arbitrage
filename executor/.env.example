# Prism Executor Environment Template
# Handles trade execution and risk limits. Dry-run uses dummy keys; live mode fails fast if secrets are missing.
# Secrets are supplied via SealedSecrets in Kubernetes.

##########################
# Required Configuration #
##########################

# Execution mode: dry-run-sandbox | dry-run-server | live
EXECUTION_MODE=dry-run-server

# Trading behavior mode: AUTO | REALISTIC | AGGRESSIVE
PERSONALITY_MODE=AUTO

# Panic threshold - trading halts if daily loss exceeds this percentage
LOSS_CAP_PCT=5.0

# Panic threshold - maximum acceptable latency in milliseconds
LATENCY_MAX_MS=250

###############################
# Required in LIVE mode only  #
###############################

# Binance API credentials for real trades
BINANCE_KEY=
BINANCE_SECRET=

# Wallet for settlements and sweeps
WALLET_ADDRESS=

############################
# Optional Configuration   #
############################

# Initial balance for simulations
STARTING_BALANCE=10000

# Position sizing limits
COIN_CAP_PCT=10
MAX_BOOK_DEPTH_USD=2000
WIN_RATE_THRESHOLD=0.5

# Prediction service endpoint
PREDICT_URL=http://localhost:5000/predict

# Circuit breaker thresholds (panic controls)
CB_WIN_RATE_THRESHOLD=0.35
CB_MAX_DRAWDOWN_PCT=5.0
MAX_OPEN_TRADES=5

# Feature flags and sandbox tuning
CANARY_MODE=false
GHOST_MODE=false
SANDBOX_MODE=true
USE_ENSEMBLE=true
GHOST_FEED_CHANNEL=ghost_feed
SANDBOX_SLIPPAGE=0.0005
SANDBOX_FEE=0.001
SANDBOX_LATENCY_MS=50
TEST_COLD_WALLET_ADDRESS=

# Database connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=arbdb
DB_RETRIES=3
DB_RETRY_DELAY_MS=2000

# Redis feed
REDIS_URL=redis://localhost:6379
REDIS_CHANNEL=spreads

# Analytics service endpoint
ANALYTICS_URL=http://localhost:5000/trade
