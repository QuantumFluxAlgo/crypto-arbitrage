# Prism Analytics Environment Template
# Performs predictive analysis and exposes metrics. Dry-run allows dummy data.

##########################
# Required Configuration #
##########################

# Execution mode: dry-run-sandbox | dry-run-server | live
EXECUTION_MODE=dry-run-server

# Redis connection used for data feeds
REDIS_URL=redis://localhost:6379

############################
# Optional Configuration   #
############################

# Force GPU usage (auto-detect will override if unset)
GPU_ENABLED=false

# Flask runtime environment
FLASK_ENV=development

# Paths to models
MODEL_PATH=model.h5
MODEL_SHADOW_PATH=model_shadow.h5

# Database connection for logging
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=arbdb

# Logging level for the analytics service
LOG_LEVEL=info
