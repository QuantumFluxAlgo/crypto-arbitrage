# Prism Dashboard Environment Template
# Provides monitoring and panic controls. Execution mode can be toggled from the UI.

##########################
# Required Configuration #
##########################

# API endpoint base URL
VITE_API_URL=http://localhost:8080

# Execution mode: dry-run-sandbox | dry-run-server | live
EXECUTION_MODE=dry-run-server

############################
# Optional Configuration   #
############################

# Default user for mock auth (only in dry-run)
MOCK_AUTH_USER=testuser@example.com

# Sentry error tracking
VITE_ENABLE_SENTRY=false
VITE_SENTRY_DSN=
